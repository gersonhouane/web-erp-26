# Copie para .env e ajuste. Todas as variáveis têm o prefixo WEBERP_.
WEBERP_ENVIRONMENT=development
WEBERP_DATABASE_URL=postgresql+psycopg://weberp:weberp@localhost:5432/weberp
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBERP_JWT_SECRET=troque-isto
WEBERP_REFRESH_COOKIE_SECURE=false
WEBERP_CORS_ORIGINS=["http://localhost:3000"]
